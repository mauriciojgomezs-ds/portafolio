  "categorical_columns": [
    "State",
    "Area code",
    "International plan",
    "Voice mail plan"
  ],
  "split": "provided",
  "source_base": "project",
  "decision_costs": {
    "false_negative": 5.0,
    "false_positive": 1.0
  }
}
