{
  "title": "Churn de telecomunicaciones",
  "source_zip": "data/raw/Telecom Churn Dataset.zip",
  "members": {
    "train": "churn-bigml-80.csv",
    "test": "churn-bigml-20.csv"
  },
  "target": "Churn",
  "id": null,
  "exclude": [
    "Total day charge",
    "Total eve charge",
    "Total night charge",
    "Total intl charge"
